from fastapi import APIRouter, Query
from datetime import datetime, timedelta, timezone

from app.services.prisma_auth import PrismaAuth
from app.services.prisma_client import PrismaClient
from app.utils.flatten import flatten_log

router = APIRouter()


@router.get("/traffic")
def get_traffic(
    source_ip: str | None = Query(default=None),
    source_user: str | None = Query(default=None),
    app: str | None = Query(default=None),
    action: str | None = Query(default=None),
    limit: int = Query(default=10),
):

    token = PrismaAuth().get_token()["access_token"]

    prisma = PrismaClient(token)

    now = datetime.now(timezone.utc)
    start = now - timedelta(hours=1)

    rules = [
        {
            "property": "event_time",
            "operator": "between",
            "values": [
                int(start.timestamp() * 1_000_000),
                int(now.timestamp() * 1_000_000)
            ]
        }
    ]

    if source_user:
        rules.append(
            {
                "property": "source_user",
                "operator": "contains",
                "values": [source_user]
            }
        )

    if app:
        rules.append(
            {
                "property": "app",
                "operator": "equals",
                "values": [app]
            }
        )

    if action:
        rules.append(
            {
                "property": "action.value",
                "operator": "equals",
                "values": [action]
            }
        )

    if source_ip:
        rules.append(
            {
                "property": "source_ip.value",
                "operator": "ip_match_cidr",
                "values": [f"{source_ip}/32"]
            }
        )

    payload = {
        "filter": {
            "rules": rules
        },
        "orderBy": {
            "properties": [
                {
                    "property": "time_generated",
                    "sort": {
                        "sequence": 1,
                        "order": "desc"
                    }
                }
            ]
        },
        "count": 50000,
        "pagination": {
            "page_number": 1,
            "page_size": limit
        }
    }

    result = prisma.query(
        endpoint="firewall_traffic",
        payload=payload
    )

    logs = [
        flatten_log(row)
        for row in result.get("data", [])
    ]

    return {
        "count": len(logs),
        "logs": logs
    }
